# Copy to .env and fill in the values yourself.
# Never commit .env and never paste its values into chat.

# Postgres for the local docker stack. Password: letters and digits only
# (characters like @ : / break the connection URL).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Used when running the API or tests on your machine.
# Format: postgresql+asyncpg://USER:PASSWORD@localhost:5432/DB and redis://localhost:6379/0
# docker compose sets its own values for the containers.
DATABASE_URL=
REDIS_URL=

# GitHub App (see docs/runbooks/github-app-setup.md)
GITHUB_APP_ID=
# Absolute path to the App's .pem private key, stored OUTSIDE this repo
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# Later phases
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# LLM: provider "gemini", model "gemini-3.8-flash" (ADR 0003)
LLM_PROVIDER=
LLM_MODEL=
# Key from a Google AI Studio project with NO billing account attached ($0 rule)
GEMINI_API_KEY=
# Set below your free-tier limits shown in AI Studio (about 80% of RPD and RPM)
LLM_DAILY_REQUEST_CAP=
LLM_REQUESTS_PER_MINUTE=
FRONTEND_ORIGIN=
